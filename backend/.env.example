DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True

DB_NAME=postgres
DB_USER=replace-with-your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=replace-with-your-database-host
DB_PORT=5432

# Correo: en desarrollo se imprime en la consola. Para enviar de verdad usa
# django.core.mail.backends.smtp.EmailBackend y completa los datos del servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DomiPedidosX <no-responder@domipedidosx.local>
FRONTEND_URL=http://localhost:5173

# Redis (opcional, SCRUM-119). Vacío: el tiempo real usa memoria y las tareas
# (correos, vencimiento de pedidos) se ejecutan en el momento, sin worker.
# Con Redis: REDIS_URL=redis://localhost:6379/0 y arrancar el worker y beat
# (ver docs/tareas-asincronas.md).
REDIS_URL=
# Minutos que un pedido espera la aprobación de la sede antes de cancelarse solo (0 = nunca).
PEDIDO_PENDIENTE_MINUTOS=20
