DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True

DB_NAME=postgres
DB_USER=replace-with-your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=replace-with-your-database-host
DB_PORT=5432

# Correo: en desarrollo se imprime en la consola. Para enviar de verdad usa
# django.core.mail.backends.smtp.EmailBackend y completa los datos del servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DomiPedidosX <no-responder@domipedidosx.local>
FRONTEND_URL=http://localhost:5173

# Redis (opcional, SCRUM-119). Vacío: el tiempo real usa memoria y las tareas
# (correos, vencimiento de pedidos) se ejecutan en el momento, sin worker.
# Con Redis: REDIS_URL=redis://localhost:6379/0 y arrancar el worker y beat
# (ver docs/tareas-asincronas.md).
REDIS_URL=
# Minutos que un pedido espera la aprobación de la sede antes de cancelarse solo (0 = nunca).
PEDIDO_PENDIENTE_MINUTOS=20

# --- Producción (SCRUM-143, ver docs/despliegue.md). En desarrollo déjalas vacías. ---
# Dominios del backend separados por comas (Render agrega el suyo solo)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# URL(s) del frontend que pueden llamar a la API, separadas por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Supabase exige SSL: require
DB_SSLMODE=
# Imágenes en Supabase Storage (si STORAGE_BUCKET está vacío se usa la carpeta media/)
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_DOMAIN=
# Correo por Brevo: EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=
