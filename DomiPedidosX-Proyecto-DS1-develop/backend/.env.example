DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True

DB_NAME=postgres
DB_USER=replace-with-your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=replace-with-your-database-host
DB_PORT=5432

# Opcional: Redis para compartir eventos WebSocket entre varios procesos/instancias.
# Sin esta variable se utiliza una capa en memoria (desarrollo de un solo proceso).
# REDIS_URL=redis://127.0.0.1:6379/0
